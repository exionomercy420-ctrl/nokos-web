# Copy these names into your local .env.local and enter values locally.
# Never commit .env.local or paste secret values into chat.
AI_GATEWAY_API_KEY=

# DOKU Checkout credentials (server-side only; rotate any credentials shared in chat).
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=sandbox

# Optional public base URL used for checkout return URLs.
NEXT_PUBLIC_SITE_URL=
